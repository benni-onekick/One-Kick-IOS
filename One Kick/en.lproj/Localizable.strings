/* Privacy Policy */
"legal.privacy.title" = "Privacy Policy";
"legal.privacy.s1.title" = "Overview";
"legal.privacy.s1.text" = "This app is a private, non-commercial project in the testing phase. This privacy policy explains which data is processed and where.";
"legal.privacy.s2.title" = "Data Controller (Art. 4 No. 7 GDPR)";
"legal.privacy.s3.title" = "Firebase Authentication";
"legal.privacy.s3.text" = "Firebase Authentication by Google LLC is used for sign-in. Your email address is stored on Google (Firebase) servers. Google LLC is based in the USA; data transfers are based on EU Standard Contractual Clauses.";
"legal.privacy.s3.link" = "Firebase Privacy Policy: firebase.google.com/support/privacy";
"legal.privacy.s4.title" = "Firebase Firestore (Database)";
"legal.privacy.s4.intro" = "The following data is stored in Firebase Firestore (Google LLC) to provide app features:";
"legal.privacy.s4.b1" = "• Tips, usernames, community memberships, match results, and bonus tips";
"legal.privacy.s4.b2" = "• Chat messages within communities (text, sender ID, timestamp)";
"legal.privacy.s4.b3" = "• Global Community: selected leagues, points and ranking per league";
"legal.privacy.s4.b4" = "• Badges / Achievements: unlocked and displayed achievements";
"legal.privacy.s4.b5" = "• Join date: timestamp of account creation";
"legal.privacy.s4.legal" = "Legal basis: Art. 6 para. 1 lit. b GDPR (contract performance / pre-contractual measures).";
"legal.privacy.s5.title" = "Sign in with Apple and Google";
"legal.privacy.s5.text1" = "The app offers sign-in with Apple ID or Google account. Authentication data (name, email) is transmitted to Firebase Authentication. No passwords are stored in the app.";
"legal.privacy.s5.text2" = "When signing in with Apple, only the data you share is processed. Apple transmits this once at first sign-in.";
"legal.privacy.s5.link1" = "Apple Privacy: apple.com/legal/privacy";
"legal.privacy.s5.link2" = "Google Privacy: policies.google.com/privacy";
"legal.privacy.s6.title" = "API-Football (Match Data)";
"legal.privacy.s6.text" = "Requests are made to the API-Football interface for schedules, results and statistics. No personal data is transmitted.";
"legal.privacy.s7.title" = "Local Storage (on your device)";
"legal.privacy.s7.text" = "Settings such as favorite leagues and display options are stored exclusively locally via UserDefaults on your device and are not transmitted to external servers.";
"legal.privacy.s8.title" = "Apple App Store / Crash Reports";
"legal.privacy.s8.text" = "The app is distributed via the Apple App Store. Apple may collect anonymized crash and usage data. Processing is anonymous; individual users cannot be identified.";
"legal.privacy.s9.title" = "Your Rights (GDPR)";
"legal.privacy.s9.text1" = "You have the right to access (Art. 15), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18) and data portability (Art. 20).";
"legal.privacy.s9.text2" = "To exercise your rights, contact us by email: benni.diedrich@gmail.com";
"legal.privacy.s10.title" = "No Ads, No Tracking";
"legal.privacy.s10.text" = "This app contains no advertising, no third-party tracking, and no analytics tools (e.g. Google Analytics).";
"legal.privacy.stand" = "Last Updated";
"legal.privacy.date" = "June 2026";

