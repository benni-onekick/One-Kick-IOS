/* Privacy */
"legal.privacy.title" = "Privacy";
"legal.privacy.s1.title" = "Panoramica";
"legal.privacy.s1.text" = "Questa app è un progetto privato e non commerciale in fase di test. L'informativa sulla privacy spiega quali dati vengono trattati e dove.";
"legal.privacy.s2.title" = "Titolare del trattamento (art. 4 n. 7 GDPR)";
"legal.privacy.s3.title" = "Firebase Authentication";
"legal.privacy.s3.text" = "Per l'accesso viene utilizzato Firebase Authentication di Google LLC. Il tuo indirizzo e-mail viene memorizzato sui server di Google (Firebase). Google LLC ha sede negli USA; il trasferimento dei dati avviene sulla base delle clausole contrattuali standard dell'UE.";
"legal.privacy.s3.link" = "Informativa privacy Firebase: firebase.google.com/support/privacy";
"legal.privacy.s4.title" = "Firebase Firestore (database)";
"legal.privacy.s4.intro" = "I seguenti dati vengono memorizzati in Firebase Firestore (Google LLC) per fornire le funzioni dell'app:";
"legal.privacy.s4.b1" = "• Dati dei pronostici, nomi utente, appartenenze alle community, risultati e pronostici bonus";
"legal.privacy.s4.b2" = "• Messaggi in chat all'interno delle community (testo, ID mittente, timestamp)";
"legal.privacy.s4.b3" = "• Community globale: leghe selezionate, punteggio e posizione";
"legal.privacy.s4.b4" = "• Badge / risultati: achievement sbloccati e mostrati";
"legal.privacy.s4.b5" = "• Data di iscrizione: timestamp della creazione dell'account";
"legal.privacy.s4.legal" = "Base giuridica: art. 6 par. 1 lett. b GDPR (esecuzione del contratto / misure precontrattuali).";
"legal.privacy.s5.title" = "Accesso con Apple e Google";
"legal.privacy.s5.text1" = "L'app offre la possibilità di accedere con l'Apple ID o un account Google. I dati di autenticazione (nome, e-mail) vengono trasmessi a Firebase Authentication. Nell'app non vengono memorizzate password.";
"legal.privacy.s5.text2" = "Con l'accesso tramite Apple vengono trattati solo i dati che hai autorizzato. Apple li trasmette una sola volta al primo accesso.";
"legal.privacy.s5.link1" = "Privacy Apple: apple.com/legal/privacy";
"legal.privacy.s5.link2" = "Privacy Google: policies.google.com/privacy";
"legal.privacy.s6.title" = "API-Football (dati delle partite)";
"legal.privacy.s6.text" = "Per calendari, risultati e statistiche vengono inviate richieste all'interfaccia API-Football. Non vengono trasmessi dati personali.";
"legal.privacy.s7.title" = "Memoria locale (sul tuo dispositivo)";
"legal.privacy.s7.text" = "Impostazioni come leghe preferite e opzioni di visualizzazione vengono salvate esclusivamente in locale tramite UserDefaults sul tuo dispositivo e non vengono trasmesse a server esterni.";
"legal.privacy.s8.title" = "Apple App Store / segnalazioni di crash";
"legal.privacy.s8.text" = "L'app viene distribuita tramite l'Apple App Store. Apple può raccogliere dati anonimi su crash e utilizzo. Il trattamento è anonimo; non è possibile identificare i singoli utenti.";
"legal.privacy.s9.title" = "I tuoi diritti (GDPR)";
"legal.privacy.s9.text1" = "Hai diritto di accesso (art. 15), rettifica (art. 16), cancellazione (art. 17), limitazione del trattamento (art. 18) e portabilità dei dati (art. 20).";
"legal.privacy.s9.text2" = "Per esercitare i tuoi diritti scrivi un'e-mail a: benni.diedrich@gmail.com";
"legal.privacy.s10.title" = "Niente pubblicità, niente tracciamento";
"legal.privacy.s10.text" = "Questa app non contiene pubblicità, né tracciamento di terze parti, né strumenti di analisi (ad es. Google Analytics).";
